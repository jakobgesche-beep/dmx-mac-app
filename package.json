{
  "name": "dmx-lichtsteuerung",
  "version": "2.0.0",
  "description": "Lichtsteuerung für Bühne: Enttec DMX USB PRO, Moving Heads, Strobos, Musik- und Kamera-Unterstützung",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "publish": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.technikag.dmxsteuerung",
    "productName": "DMX Lichtsteuerung",
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "DMX-Lichtsteuerung.${ext}",
      "identity": null,
      "icon": "build/icon.icns",
      "extendInfo": {
        "NSCameraUsageDescription": "Für die Kamera-Kontrolle der Bühne (z. B. iPhone-Kamera): Die App vergleicht, ob das Licht auf der Bühne zum Plan passt.",
        "NSMicrophoneUsageDescription": "Für die Musik-Erkennung (Takt und Tempo) über das Audio-Interface am Pult."
      }
    },
    "afterSign": "scripts/afterSignAdHoc.js",
    "publish": {
      "provider": "github",
      "owner": "jakobgesche-beep",
      "repo": "dmx-mac-app",
      "private": false,
      "releaseType": "release"
    },
    "npmRebuild": false
  }
}
